#!/bin/bash
# VibeLight pre-commit guard: keep private network topology out of the PUBLIC repo.
#
# CLAUDE.md's rule is that real IPs / host UUIDs / Wake-on-LAN MACs live ONLY in
# a gitignored *.local.md file. This scans the STAGED additions for those shapes
# so the leak that already sits in this repo's history can't be extended.
#
# Enable once per clone:  git config core.hooksPath scripts/git-hooks
#
# ── Why there's an allowlist ────────────────────────────────────────────────
# The first version of this hook blocked on any RFC1918 / CGNAT / MAC shape.
# That fires on things the repo legitimately contains and should keep: the
# documentation placeholders in docs/research/gamestream-api.md, the fake hosts
# in VibeLightTests, the "e.g. 192.168.1.20" in a user-facing error string, and
# the guard's own regexes below. A hook that cries wolf on correct commits
# doesn't get fixed — it gets bypassed, and `--no-verify` becomes muscle memory
# that also waves through the real leak. So: block on values that are NOT
# recognizable placeholders, and give a per-line escape hatch for the rest.
#
# Escape hatch: put  topology-ok  in a comment on the same line.
# Whole-commit bypass (last resort, still supported): git commit --no-verify

set -u
fail=0
block() { echo "  ✖ $1"; fail=1; }
warn()  { echo "  ⚠ $1"; }

# Only added lines (leading '+'), excluding the +++ file header.
added="$(git diff --cached --unified=0 --no-color | grep -E '^\+[^+]' || true)"
[ -z "$added" ] && exit 0

# Drop lines the author explicitly marked, then drop the documentation
# placeholders this project has standardized on. Anything left is suspect.
#
#   192.168.1.*      the RFC5737-style example subnet used throughout docs
#   10.0.0.0 / *.0.0 bare network addresses (a range, not a host)
#   100.64.0.*       the CGNAT range's own base + the test fixtures' fake host
#   aa:bb:cc:dd:ee:ff / 00:00:00:00:00:00   the doc + "unknown" MACs
#   x.x.x.255 / .0   broadcast + network suffixes in explanatory prose
candidates="$(grep -v 'topology-ok' <<<"$added" \
  | sed -E 's/(^|[^0-9.])192\.168\.1\.[0-9]{1,3}/\1<placeholder>/g;
            s/(^|[^0-9.])100\.64\.0\.[0-9]{1,3}/\1<placeholder>/g;
            s/(^|[^0-9.])(10|172\.16|192\.168)\.0\.0/\1<placeholder>/g;
            s/([0-9]{1,3}\.){3}(255|0)([^0-9]|$)/<placeholder>\3/g;
            s/(aa:bb:cc:dd:ee:ff|00:00:00:00:00:00)/<placeholder>/gI')"

# RFC1918 LAN ranges.
if grep -Eq '(^|[^0-9.])(192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3})' <<<"$candidates"; then
  block "a private LAN IP (RFC1918) was added"
fi
# Tailscale CGNAT range 100.64.0.0/10.
if grep -Eq '(^|[^0-9.])100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}' <<<"$candidates"; then
  block "a Tailscale-range IP (100.64.0.0/10) was added"
fi
# A MAC address (colon- or dash-separated 6 octets) — the WoL MAC is sensitive.
if grep -Eiq '(^|[^0-9a-f:.-])([0-9a-f]{2}[:-]){5}[0-9a-f]{2}([^0-9a-f:.-]|$)' <<<"$candidates"; then
  block "a MAC address was added (the Wake-on-LAN MAC is private)"
fi
# A bare host UUID — warn only (canonical UUIDs are also legitimate in code).
if grep -Eiq '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' <<<"$candidates"; then
  warn "a UUID-shaped value was added — if it's a real host UUID, move it to CLAUDE.local.md"
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-commit: refusing to commit private network topology to a public repo."
  echo "  Move the value to CLAUDE.local.md (gitignored), or — if it really is an"
  echo "  example — add a  topology-ok  comment to that line so the next commit"
  echo "  doesn't hit this again. Whole-commit bypass: git commit --no-verify"
  exit 1
fi
exit 0
