<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tray app: Windows only, plain Win32 (no Windows Forms), so it builds
       from any OS. `dotnet publish -c Release` makes one self-contained
       VibeLightHelper.exe that needs nothing installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VibeLightHelper</RootNamespace>
    <AssemblyName>VibeLightHelper</AssemblyName>
    <Product>VibeLight Helper</Product>
    <Version>0.1.2</Version>
    <ApplicationIcon>helper.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Every publish also leaves a copy named with the version beside the
       projects: WindowsHelper/VibeLightHelperV0.1.1.exe, the one in git. -->
  <Target Name="CopyVersionedExe" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe"
          DestinationFiles="$(MSBuildThisFileDirectory)../VibeLightHelperV$(Version).exe" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VibeLightHelper.Core\VibeLightHelper.Core.csproj" />
    <EmbeddedResource Include="helper.ico" LogicalName="VibeLightHelper.helper.ico" />
  </ItemGroup>

</Project>
